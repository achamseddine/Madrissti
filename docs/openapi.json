  "components": {
    "schemas": {
      "Auth": {
        "properties": {
          "access_code": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Access Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_code"
        ],
        "title": "Auth"
      },
      "Context": {
        "properties": {
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id"
          },
          "content_version": {
            "type": "string",
            "title": "Content Version"
          },
          "selected_block_id": {
            "type": "string",
            "title": "Selected Block Id"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "ar"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "text"
          },
          "preferences": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Preferences"
          },
          "previous_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Previous Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lesson_id",
          "content_version",
          "selected_block_id",
          "previous_revision"
        ],
        "title": "Context"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Rational": {
        "properties": {
          "numerator": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 0.0,
            "title": "Numerator"
          },
          "denominator": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Denominator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "numerator",
          "denominator"
        ],
        "title": "Rational"
      },
      "RenderRequest": {
        "properties": {
          "whole_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Whole Id"
          },
          "values": {
            "items": {
              "$ref": "#/components/schemas/Rational"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Values"
          },
          "context_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Context Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "whole_id",
          "values",
          "context_revision"
        ],
        "title": "RenderRequest"
      },
      "Selection": {
        "properties": {
          "lesson_id": {
            "type": "string",
            "title": "Lesson Id"
          },
          "content_version": {
            "type": "string",
            "title": "Content Version"
          },
          "selected_block_id": {
            "type": "string",
            "title": "Selected Block Id"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "ar"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "text"
          },
          "preferences": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Preferences"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lesson_id",
          "content_version",
          "selected_block_id"
        ],
        "title": "Selection"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
